
#Sidebar {
    background-color: #1E90FF;
}
#layout{
    background-color: #1E90FF;
}
#feedback_title{
    font-size: 24px;
    font-weight: bold;
    color:#fff;
}

/* Основний стиль для всіх таблиць у програмі */
QTableWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #3f3f3f;
    border-radius: 8px;
    gridline-color: #3f3f3f;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
    font-size: 14px;
}

/* Стиль для заголовків (верхнього ряду) */
QHeaderView::section {
    background-color: #1e1e1e;
    color: #a0a0a0;
    padding: 8px;
    border: none;
    border-right: 1px solid #3f3f3f;
    border-bottom: 1px solid #3f3f3f;
    font-weight: bold;
    font-size: 14px;
}

/* Куточок між заголовками (якщо є) */
QTableCornerButton::section {
    background-color: #1e1e1e;
    border: none;
}